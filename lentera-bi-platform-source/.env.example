# Database
# Development metadata database (resolved relative to prisma/schema.prisma).
# Run `npm run db:setup` to create this file from the migration directory
# without invoking the Prisma migrate engine (avoids Windows EPERM issues).
DATABASE_URL="file:./lentera.db"

# Upload directory
UPLOAD_DIR="./upload"

# Server
PORT=3000
HOST="0.0.0.0"

# Environment
NODE_ENV="development"
